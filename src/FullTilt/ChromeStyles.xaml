<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FullTilt">
  <Style x:Key="ScrollPage" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ScrollGrip" TargetType="Thumb"><Setter Property="local:UiMotion.Interactive" Value="True"/>
    <Setter Property="MinWidth" Value="24"/><Setter Property="MinHeight" Value="24"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
      <Border x:Name="Grip" Background="{DynamicResource Muted}" CornerRadius="5" Margin="3" Opacity="0.6"/>
      <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#C8F35B"/><Setter TargetName="Grip" Property="Opacity" Value="1"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="#C8F35B"/><Setter TargetName="Grip" Property="Opacity" Value="1"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="14"/><Setter Property="MinWidth" Value="0"/><Setter Property="Background" Value="{DynamicResource ThemeFCFDFB}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
      <Border Background="{TemplateBinding Background}" CornerRadius="7">
        <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
          <Track.DecreaseRepeatButton><RepeatButton x:Name="Before" Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPage}"/></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb x:Name="GripThumb" Style="{StaticResource ScrollGrip}" MinWidth="0"/></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton x:Name="After" Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPage}"/></Track.IncreaseRepeatButton>
        </Track>
      </Border>
      <ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="GripThumb" Property="MinWidth" Value="24"/><Setter TargetName="GripThumb" Property="MinHeight" Value="0"/><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="Before" Property="Command" Value="ScrollBar.PageLeftCommand"/><Setter TargetName="After" Property="Command" Value="ScrollBar.PageRightCommand"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="14"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="ShortcutMenu" TargetType="ContextMenu"><Setter Property="local:UiMotion.Interactive" Value="True"/>
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="MinWidth" Value="220"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu"><Border CornerRadius="12" Background="{DynamicResource ThemeFFFFFF}" BorderBrush="{DynamicResource ThemeE0E5DC}" BorderThickness="1" Padding="6"><ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/></ScrollViewer></Border></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ShortcutMenuItem" TargetType="MenuItem"><Setter Property="local:UiMotion.Interactive" Value="True"/>
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="IsCheckable" Value="True"/><Setter Property="StaysOpenOnClick" Value="True"/><Setter Property="Margin" Value="0,2"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
      <Border x:Name="Row" Background="Transparent" CornerRadius="8" Padding="10,8" BorderBrush="Transparent" BorderThickness="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="Check" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="5" BorderThickness="1" BorderBrush="{DynamicResource Muted}"><TextBlock x:Name="Tick" Text="✓" Foreground="#18251B" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/></Border><ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/></Grid></Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Background" Value="#C8F35B"/><Setter TargetName="Check" Property="BorderBrush" Value="#C8F35B"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/><Setter TargetName="Row" Property="Background" Value="{DynamicResource ThemeECFBCD}"/></Trigger>
        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#C8F35B"/><Setter TargetName="Row" Property="Background" Value="{DynamicResource ThemeFCFDFB}"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#C8F35B"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
