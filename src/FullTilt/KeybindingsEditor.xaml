<UserControl x:Class="FullTilt.KeybindingsEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FullTilt">
 <UserControl.Resources>
  <Style x:Key="KeybindingSearch" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
   <Setter Property="Padding" Value="8,0,8,0" /><Setter Property="CaretBrush" Value="{DynamicResource Ink}" />
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
    <Border x:Name="SearchFrame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <TextBlock x:Name="SearchIcon" Text="⌕" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource Muted}" />
      <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
     </Grid>
    </Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="SearchFrame" Property="BorderBrush" Value="{DynamicResource Theme84BC3B}" /></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ListBoxItem"><Setter Property="local:UiMotion.Interactive" Value="True"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="8,6" /><Setter Property="Margin" Value="0,1" />
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="Frame" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border>
    <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ThemeECFBCB}" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ThemeEDF0E9}" /></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ActionCategory" TargetType="Expander"><Setter Property="local:UiMotion.Interactive" Value="True"/>
   <Setter Property="Margin" Value="0,0,0,5" />
   <EventSetter Event="Loaded" Handler="CategoryLoaded" /><EventSetter Event="Expanded" Handler="CategoryExpanded" /><EventSetter Event="Collapsed" Handler="CategoryCollapsed" />
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><StackPanel>
    <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Content="{TemplateBinding Header}">
     <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="CategoryFrame" CornerRadius="7" Background="Transparent" BorderBrush="{DynamicResource ThemeE7EBE3}" BorderThickness="0,0,0,1" Padding="10,9"><DockPanel><TextBlock x:Name="Chevron" Text="›" DockPanel.Dock="Left" Margin="0,0,10,0" /><ContentPresenter /></DockPanel></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Text" Value="⌄" /></Trigger><DataTrigger Binding="{Binding Path=(local:KeybindingsEditor.IsCurrentCategory), RelativeSource={RelativeSource AncestorType=Expander}}" Value="True"><Setter TargetName="CategoryFrame" Property="Background" Value="{DynamicResource ThemeECFBCB}" /></DataTrigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CategoryFrame" Property="BorderBrush" Value="{DynamicResource Theme84BC3B}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
    </ToggleButton>
    <ContentPresenter x:Name="CategoryBody" ContentSource="Content" Visibility="Collapsed" Margin="25,4,0,0" />
   </StackPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="CategoryBody" Property="Visibility" Value="Visible" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <Grid x:Name="EditorLayout">
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="BoardColumn" Width="*" /><ColumnDefinition x:Name="AssignmentColumn" Width="360" /></Grid.ColumnDefinitions>
  <ContentControl x:Name="ControllerBoardHost" Margin="0,4,24,0" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch" />
  <Border x:Name="AssignmentPane" Grid.Column="1" BorderBrush="{DynamicResource ThemeE7EBE3}" BorderThickness="1,0,0,0" Padding="20,0,0,0">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel>
     <TextBlock x:Name="Heading" Text="Assign action" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,10" />
     <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource ThemeDCE2D8}" Padding="9,6" Margin="0,0,12,0"><TextBlock x:Name="TargetBadge" FontWeight="SemiBold" FontSize="17" /></Border>
      <TextBlock x:Name="TargetName" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="15" />
     </Grid>
     <ComboBox x:Name="ControlPicker" DisplayMemberPath="Label" SelectionChanged="ControlChanged" AutomationProperties.Name="Choose controller target" MaxDropDownHeight="420" Visibility="Collapsed" Margin="0,0,0,12" />
     <Border x:Name="AssignmentStatus" Background="{DynamicResource ThemeEDF0E9}" CornerRadius="8" Padding="10,9" Margin="0,0,0,14"><TextBlock x:Name="CurrentAssignment" TextWrapping="Wrap" FontWeight="SemiBold" /></Border>
     <Button x:Name="RecordKeysButton" Content="Record key / shortcut" Click="RecordKeys_Click" HorizontalAlignment="Left" Margin="0,0,0,12" AutomationProperties.Name="Record key or shortcut for selected controller target" />
     <Grid Margin="0,0,0,12"><TextBox x:Name="Search" Style="{StaticResource KeybindingSearch}" Height="42" TextChanged="SearchChanged" AutomationProperties.Name="Search keybinding actions" />
      <TextBlock x:Name="SearchPlaceholder" Text="Search actions..." Margin="43,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource Muted}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Text, ElementName=Search}" Value="" /><Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=Search}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     </Grid>
     <TextBlock x:Name="ModeHint" Text="D-pad moves the cursor. Choose Assigned actions in Button Assignment to edit its actions." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,8" Visibility="Collapsed" />
     <TextBlock x:Name="ActionHeading" Visibility="Collapsed" FontSize="13" Foreground="{DynamicResource Muted}" Margin="0,0,0,8" />
    </StackPanel>
    <ListBox x:Name="Actions" Grid.Row="1" SelectionChanged="ActionChanged" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" VirtualizingPanel.IsVirtualizing="False" AutomationProperties.Name="Keybinding action choices">
     <ListBox.GroupStyle><GroupStyle><GroupStyle.ContainerStyle><Style TargetType="GroupItem"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupItem"><Expander Header="{Binding Name}" Tag="{Binding Name}" Style="{StaticResource ActionCategory}" AutomationProperties.Name="{Binding Name}"><ItemsPresenter /></Expander></ControlTemplate></Setter.Value></Setter></Style></GroupStyle.ContainerStyle></GroupStyle></ListBox.GroupStyle>
     <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center"><Ellipse Stroke="{DynamicResource Muted}" StrokeThickness="1" /><Ellipse Width="8" Height="8" Fill="{DynamicResource Theme84BC3B}"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse></Grid><TextBlock Grid.Column="1" Text="{Binding Label}" ToolTip="{Binding Description}" TextWrapping="Wrap" FontSize="13" /></Grid></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Row="2" Margin="0,14,0,0"><Border Height="1" Background="{DynamicResource ThemeE7EBE3}" Margin="0,0,0,10" /><TextBlock x:Name="TargetHelp" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="13" /></StackPanel>
   </Grid>
  </Border>
 </Grid>
</UserControl>
