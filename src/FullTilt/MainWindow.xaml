<Window x:Class="FullTilt.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FullTilt"
        Title="FullTilt" WindowStyle="SingleBorderWindow" ResizeMode="CanResize" AllowsTransparency="False" Width="1536" Height="864" MinWidth="760" MinHeight="427.5" WindowStartupLocation="CenterScreen" Icon="Assets/FullTilt.ico" UseLayoutRounding="True" Style="{StaticResource {x:Type Window}}">
  <Window.Resources>
    <DataTemplate x:Key="BindingTemplate">
      <Grid Margin="0,0,12,8"><Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" Margin="0,0,8,0" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Selection, Mode=TwoWay}" IsSynchronizedWithCurrentItem="False" AutomationProperties.Name="{Binding AccessibilityName}" AutomationProperties.HelpText="{Binding Description}" ToolTip="{Binding Description}" MaxDropDownHeight="390" IsTextSearchEnabled="True" TextSearch.TextPath="Label" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem"><Setter Property="local:UiMotion.Interactive" Value="True"/><Setter Property="ToolTip" Value="{Binding Description}" /><Setter Property="Padding" Value="8,5" /></Style></ComboBox.ItemContainerStyle>
          <ComboBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="8,8,8,3" /></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ComboBox.GroupStyle>
        </ComboBox>
      </Grid>
    </DataTemplate>
    <Style x:Key="SettingsSwitch" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="local:UiMotion.Interactive" Value="True"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,12,0,6"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid MinHeight="34"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/><Border x:Name="Track" Grid.Column="1" CornerRadius="14" Height="26" Background="{DynamicResource ThemeE0E5DC}" BorderBrush="{DynamicResource ThemeE7EBE3}" BorderThickness="1"><Ellipse x:Name="Thumb" Width="20" Height="20" HorizontalAlignment="Left" Margin="3,0" Fill="#FAFBF7"/></Border></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource ThemeBAEF6C}"/><Setter TargetName="Thumb" Property="local:UiMotion.OffsetX" Value="22"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ShortcutChip" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="local:UiMotion.Interactive" Value="True"/><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,4,10,4"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Border x:Name="Chip" CornerRadius="9" BorderThickness="1" BorderBrush="{DynamicResource ThemeE0E5DC}" Background="{DynamicResource ThemeFCFDFB}" Padding="{TemplateBinding Padding}"><StackPanel Orientation="Horizontal"><ContentPresenter/><TextBlock Text=" ×" Margin="6,0,0,0" Foreground="{DynamicResource Muted}"/></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsChecked" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter><Style.Triggers><DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=local:SettingsPanel}}" Value="True"><Setter Property="Padding" Value="8,5"/><Setter Property="Margin" Value="0,2,6,2"/></DataTrigger></Style.Triggers></Style>
    <Style x:Key="ThemeSegment" TargetType="ListBoxItem"><Setter Property="local:UiMotion.Interactive" Value="True"/><Setter Property="Padding" Value="12,8"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Segment" BorderBrush="{DynamicResource ThemeE0E5DC}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Segment" Property="Background" Value="{DynamicResource ThemeECFBCD}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Segment" Property="Background" Value="{DynamicResource ThemeEAF9CA}"/><Setter TargetName="Segment" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style x:Key="SavedShortcutKey" TargetType="Border"><Setter Property="Padding" Value="16,8"/><Setter Property="Margin" Value="0,0,8,4"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=local:SettingsPanel}}" Value="True"><Setter Property="Padding" Value="6,4"/><Setter Property="Margin" Value="0,0,4,2"/></DataTrigger></Style.Triggers></Style>
    <Style x:Key="SettingsButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="local:UiMotion.Interactive" Value="True"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ActionFrame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ActionFrame" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ActionFrame" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ActionFrame" Property="Opacity" Value="0.75"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ActionFrame" Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  </Window.Resources>
  <Grid x:Name="AppLayout" Margin="24,18,24,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Grid x:Name="BrandHeader" Margin="4,2,4,22"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="ProfileColumn" Width="620" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><local:BrandLogo x:Name="HeaderLogo" Width="234" Height="64" AutomationProperties.Name="FullTilt full-color logo" /><TextBlock x:Name="HeaderVersion" FontSize="18" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="8,17,0,0" /></StackPanel>          <Grid x:Name="ProfileControls" Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Label Content="_Profile" Target="{Binding ElementName=ProfilePicker}" Padding="0,0,14,0" VerticalAlignment="Center" />
            <ComboBox x:Name="ProfilePicker" Grid.Column="1" ItemsSource="{Binding Profiles}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding ActiveProfileId, Mode=OneWay}" SelectionChanged="Profile_SelectionChanged" AutomationProperties.Name="FullTilt profile" />
            <Button Grid.Column="2" Content="Save" Click="SaveProfile_Click" Margin="8,0,0,0" AutomationProperties.Name="Save FullTilt profile" />
            <Button Grid.Column="3" Content="Rename" Click="RenameProfile_Click" Margin="8,0,0,0" AutomationProperties.Name="Rename FullTilt profile" />
            <Button Grid.Column="4" Content="Delete" Click="DeleteProfile_Click" IsEnabled="{Binding CanDeleteProfile}" Margin="8,0,0,0" AutomationProperties.Name="Delete FullTilt profile" ToolTip="Keep at least one profile" />
            <Button Grid.Column="5" Content="New" Click="NewProfile_Click" Margin="8,0,0,0" AutomationProperties.Name="New FullTilt profile" />
          </Grid></Grid>
    <Grid x:Name="Workspace" Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="104" /><ColumnDefinition x:Name="HeroColumn" Width="1.35*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Grid x:Name="HeroRegion" Grid.Column="1" Panel.ZIndex="2" Margin="12,0,18,0"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><ContentControl x:Name="ControllerHeroHost" /></Grid>
    <TabControl x:Name="SettingsTabs" Grid.ColumnSpan="3" SelectedIndex="1" BorderThickness="0" Background="{DynamicResource ThemeFFFFFF}" TabStripPlacement="Left">
      <TabControl.Template>
        <ControlTemplate TargetType="TabControl">
          <Border CornerRadius="22" Background="{DynamicResource ThemeFDFEFC}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="104" /><ColumnDefinition x:Name="HeroSpacer" Width="0" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <ScrollViewer x:Name="NavigationScroll" Panel.ZIndex="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <local:NavigationPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" MinHeight="{Binding ViewportHeight, ElementName=NavigationScroll}" />
              </ScrollViewer>
              <Border Grid.Column="2" Margin="-1,0,0,0" CornerRadius="18" Background="{DynamicResource ThemeFFFFFF}" BorderBrush="{DynamicResource ThemeE7EBE3}" BorderThickness="1" Padding="18,16">
                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
              </Border>
            </Grid>
          </Border>
        </ControlTemplate>
      </TabControl.Template>
      <TabItem Tag="2" KeyboardNavigation.TabIndex="2"><TabItem.Header><StackPanel><local:UiIcon Kind="Movement" Width="28" Height="28" HorizontalAlignment="Center" Margin="0,0,0,6" /><TextBlock Text="Movement" FontSize="11" /></StackPanel></TabItem.Header>
        <ScrollViewer x:Name="MovementScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,12,0,0" FontWeight="Normal">
          <ContentControl x:Name="MovementSections" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        </ScrollViewer>
      </TabItem>
      <TabItem Tag="0" KeyboardNavigation.TabIndex="0"><TabItem.Header><StackPanel><local:UiIcon Kind="Keybindings" Width="28" Height="28" HorizontalAlignment="Center" Margin="0,0,0,6" /><TextBlock Text="Keybindings" FontSize="11" /></StackPanel></TabItem.Header>
        <ContentControl x:Name="KeybindingsHost" FontWeight="Normal" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
      </TabItem>
      <TabItem Tag="3" KeyboardNavigation.TabIndex="3"><TabItem.Header><StackPanel><local:UiIcon Kind="Pie" Width="28" Height="28" HorizontalAlignment="Center" Margin="0,0,0,6" /><TextBlock Text="Pie Menus" FontSize="11" /></StackPanel></TabItem.Header><ContentControl x:Name="PieEditorHost" /></TabItem>
<TabItem Tag="1" KeyboardNavigation.TabIndex="1" Visibility="Collapsed"><TabItem.Header><StackPanel><TextBlock Text="☷" FontSize="27" HorizontalAlignment="Center" Margin="0,0,0,6" /><TextBlock Text="Button Assignment" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" /></StackPanel></TabItem.Header><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,12,0,0" FontWeight="Normal"><Border Background="Transparent"><StackPanel><TextBlock Text="Button Assignment" Style="{StaticResource SectionTitle}" Margin="0,0,0,16" /><Border x:Name="BindingDetails"><StackPanel>
            <TextBlock Text="Choose an action, or type its name to jump to it. Hover a choice for details." Style="{StaticResource Help}" Margin="0,0,0,12" />
            <DockPanel Margin="0,0,0,14"><Label Content="_D-pad mode" Target="{Binding ElementName=DPadModePicker}" Padding="0,0,16,0" VerticalAlignment="Center" /><ComboBox x:Name="DPadModePicker" ItemsSource="{Binding DPadModeOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding DPadMode, Mode=TwoWay}" AutomationProperties.Name="D-pad mode" /></DockPanel>
            <ItemsControl ItemsSource="{Binding Bindings}" ItemTemplate="{StaticResource BindingTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
            <StackPanel Visibility="{Binding IsDPadActionMode, Converter={StaticResource BoolToVisibility}}" Margin="0,10,0,0">
              <TextBlock Text="D-pad actions" FontWeight="SemiBold" Margin="0,0,0,10" />
              <ItemsControl ItemsSource="{Binding DPadBindings}" ItemTemplate="{StaticResource BindingTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
              <TextBlock Text="One direction owns an action until released. Multiple new directions wait until only one remains." Style="{StaticResource Help}" Margin="0,0,0,8" />
            </StackPanel>

            <TextBlock Text="Precision while held slows the cursor while pressed. Precision toggle stays on until pressed again; either can activate precision." Style="{StaticResource Help}" Margin="0,14,0,0" />
            <TextBlock Text="Drag lock holds left click until pressed again. Release/cancel clears held input and modes; it does not undo desktop changes." Style="{StaticResource Help}" Margin="0,8,0,0" />
            <TextBlock Text="Sticky Ctrl and Shift toggle until pressed again or canceled. Volume up/down repeat while held." Style="{StaticResource Help}" Margin="0,8,0,0" />
            <TextBlock Text="Named shortcuts act in the foreground app. FullTilt suspends its conflicting sticky modifiers during a shortcut; physical keyboard modifiers can still change its effect." Style="{StaticResource Help}" Margin="0,8,0,0" />
            <TextBlock Text="Touch keyboard: select a text field, then press its assigned button to show/hide. Use Windows keyboard settings to dock it. Typing remains subject to Windows permissions and version." Style="{StaticResource Help}" Margin="0,8,0,0" />
          </StackPanel></Border></StackPanel></Border></ScrollViewer></TabItem>
<TabItem Tag="4" KeyboardNavigation.TabIndex="4"><TabItem.Header><StackPanel><local:UiIcon Kind="Settings" Width="28" Height="28" HorizontalAlignment="Center" Margin="0,0,0,6"/><TextBlock Text="Settings" FontSize="11"/></StackPanel></TabItem.Header>
 <Grid x:Name="SettingsPage" TextElement.FontWeight="Normal"><Grid.Resources><Style TargetType="Button" BasedOn="{StaticResource SettingsButton}"><Setter Property="local:UiMotion.Interactive" Value="True"/></Style></Grid.Resources><Grid x:Name="SettingsFitViewport"><Grid x:Name="SettingsPageContent"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Margin="8,2,8,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Settings" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="SettingsSubtitle" Text="App preferences, controller connection and quick controls." Style="{StaticResource Help}" Margin="0,4,12,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding SaveStatus}" Style="{StaticResource Help}" VerticalAlignment="Center" MaxWidth="180"/></Grid>
  <local:SettingsPanel x:Name="SettingsSections" Grid.Row="1">
   <Border x:Name="GeneralSettings" Style="{StaticResource Card}" Margin="8"><StackPanel x:Name="AppPreferencesHost">
    <TextBlock Text="General" Style="{StaticResource SectionTitle}"/>
    <CheckBox Content="Start with Windows" Style="{StaticResource SettingsSwitch}" IsChecked="{Binding StartWithWindows}" IsEnabled="{Binding StartupAvailable}" AutomationProperties.Name="Start with Windows"/>
    <TextBlock Text="{Binding StartupDescription}" Style="{StaticResource Help}"/>
    <Separator Margin="0,18,0,12"/><TextBlock Text="Closing the window keeps FullTilt in the tray. Use the tray’s Exit command to quit." Style="{StaticResource Help}"/>
    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Theme8A3C16}" TextWrapping="Wrap" Margin="0,6,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger><Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   </StackPanel></Border>
   <Border x:Name="AppearanceSettings" Style="{StaticResource Card}" Margin="8"><StackPanel>
    <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="ThemeLabel" Text="Theme" Margin="0,12,0,6"/>
    <ListBox x:Name="ThemePicker" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme, Mode=TwoWay}" ItemContainerStyle="{StaticResource ThemeSegment}" BorderThickness="0" MaxWidth="360" HorizontalAlignment="Left" AutomationProperties.Name="App theme"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"/></DataTemplate></ListBox.ItemTemplate><ListBox.Template><ControlTemplate TargetType="ListBox"><Border><ItemsPresenter/></Border></ControlTemplate></ListBox.Template><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
    <TextBlock Text="Applies across the app. System default follows Windows." Style="{StaticResource Help}" Margin="0,8,0,12"/><Separator/>
    <CheckBox Content="On-screen state indicator" Style="{StaticResource SettingsSwitch}" IsChecked="{Binding ShowStateIndicator}" AutomationProperties.Name="Show on-screen state indicator"/>
    <TextBlock Text="Show sticky modifiers, precision and pause status. Saved with this profile." Style="{StaticResource Help}"/>
   </StackPanel></Border>
   <Border x:Name="ControllerCard" Style="{StaticResource Card}" Margin="8"><StackPanel>
    <DockPanel><TextBlock Text="Controller" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding StatusTitle}" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Right" Margin="8,0,0,4"/></DockPanel><TextBlock Text="{Binding ActiveStateText}" Foreground="{DynamicResource Accent}" TextWrapping="Wrap"/>
    <Separator Margin="0,16,0,12"/><TextBlock x:Name="ActiveControllerLabel" Text="Active controller" Margin="0,0,0,6"/><ComboBox x:Name="ControllerPicker" ItemsSource="{Binding ControllerOptions}" DisplayMemberPath="Label" SelectedValuePath="Slot" SelectedValue="{Binding ControllerSlot, Mode=TwoWay}" AutomationProperties.Name="Active controller"/>
    <UniformGrid Rows="1" Margin="0,16,0,8"><Button Content="{Binding PauseLabel}" Click="Pause_Click" Background="{DynamicResource ThemeEAF9CA}" Margin="0,0,8,0" AutomationProperties.Name="Pause or resume controller mouse"/><Button Click="Release_Click" AutomationProperties.Name="Release all FullTilt input and cancel active modes"><TextBlock Text="Release held inputs" TextWrapping="Wrap" TextAlignment="Center"/></Button></UniformGrid>
    <TextBlock Text="Pause suspends input. Release clears held keys, mouse buttons and active modes." Style="{StaticResource Help}"/>
   </StackPanel></Border>
   <Border x:Name="PauseShortcutCard" Style="{StaticResource Card}" Margin="8"><StackPanel>
    <TextBlock Text="Pause shortcut" Style="{StaticResource SectionTitle}"/><TextBlock Text="Hold your shortcut to pause or resume controller input." Style="{StaticResource Help}" Margin="0,4,0,14"/>
    <DockPanel><TextBlock Text="Current shortcut" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/><ItemsControl ItemsSource="{Binding CurrentPauseButtons}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border CornerRadius="8" Background="{DynamicResource ThemeFCFDFB}" BorderBrush="{DynamicResource ThemeE0E5DC}" BorderThickness="1" Style="{StaticResource SavedShortcutKey}"><TextBlock Text="{Binding}" FontWeight="SemiBold"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></DockPanel>
    <Separator Margin="0,16,0,12" Visibility="Collapsed"/><DockPanel LastChildFill="True" Visibility="Collapsed"><Button DockPanel.Dock="Right" Visibility="Collapsed" Content="Record shortcut" Click="RecordShortcut_Click" IsEnabled="{Binding CanRecordShortcut}" AutomationProperties.Name="Record controller pause shortcut" Margin="12,0,0,0"/><StackPanel><TextBlock Text="Record a new shortcut" FontWeight="SemiBold"/><TextBlock Text="{Binding RecordingHint}" Style="{StaticResource Help}" Margin="0,4,0,0"/></StackPanel></DockPanel>
    <Border Style="{StaticResource Card}" Background="{DynamicResource ThemeFCFDFB}" Margin="0,16,0,10"><StackPanel><TextBlock Text="New combination" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ItemsControl ItemsSource="{Binding PauseButtons}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Style="{StaticResource ShortcutChip}" Content="{Binding Label}" IsChecked="{Binding Selected, Mode=TwoWay}" AutomationProperties.Name="{Binding Label, StringFormat=Pause shortcut button {0}}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <Button Grid.Column="1" VerticalAlignment="Top" Content="＋ Add button" Click="AddShortcutButton_Click" Margin="0,4,0,4" AutomationProperties.Name="Add pause shortcut button"><Button.ContextMenu><ContextMenu Style="{StaticResource ShortcutMenu}" ItemsSource="{Binding PauseButtons}"><ContextMenu.ItemContainerStyle><Style TargetType="MenuItem" BasedOn="{StaticResource ShortcutMenuItem}"><Setter Property="local:UiMotion.Interactive" Value="True"/><Setter Property="Header" Value="{Binding Label}"/><Setter Property="IsCheckable" Value="True"/><Setter Property="IsChecked" Value="{Binding Selected, Mode=TwoWay}"/></Style></ContextMenu.ItemContainerStyle></ContextMenu></Button.ContextMenu></Button></Grid>
    <TextBlock x:Name="PauseShortcutHelp" Text="{Binding PauseShortcutHint}" Style="{StaticResource Help}" ToolTip="{Binding PauseShortcutHint}" Margin="0,12,0,0"/></StackPanel></Border>
    <TextBlock Text="Your current shortcut stays saved until you save this combination." Style="{StaticResource Help}"/>
    <WrapPanel HorizontalAlignment="Right" Margin="0,12,0,12"><Button Content="Cancel" Click="CancelShortcut_Click" Margin="0,0,8,0"/><Button Visibility="Collapsed" Content="Record again" Click="RecordShortcut_Click" IsEnabled="{Binding CanRecordShortcut}" Margin="0,0,8,0"/><Button Content="Save shortcut" Click="ApplyPauseShortcut_Click" IsEnabled="{Binding CanApplyPauseShortcut}" Background="{DynamicResource ThemeBAEF6C}" Foreground="#18251B" AutomationProperties.Name="Apply pause shortcut"/></WrapPanel>
    <Separator/><TextBlock Text="Release all buttons before pausing or resuming again." Style="{StaticResource Help}" Margin="0,10,0,0"/>
   </StackPanel></Border>
   <Border x:Name="SharedSettingsFooter" Style="{StaticResource Card}" Margin="8"><StackPanel>
    <TextBlock Text="Profiles &amp; app information" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="AppVersionText" Text="{Binding VersionLabel}" FontWeight="SemiBold" Margin="0,10,0,12"/>
    <TextBlock Text="Portable settings folder" Style="{StaticResource Help}"/><DockPanel Margin="0,6,0,6"><Button DockPanel.Dock="Right" Content="Open folder" Click="OpenSettingsFolder_Click" Margin="8,0,0,0"/><Button DockPanel.Dock="Right" Content="Copy" Click="CopySettingsFolder_Click" Margin="8,0,0,0"/><TextBox x:Name="PreferencesPath" Text="{Binding StoragePath, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap" MinWidth="40"/></DockPanel>
    <TextBlock Text="Keep this folder with FullTilt when moving the app." Style="{StaticResource Help}"/><Separator Margin="0,14,0,10"/><TextBlock Text="Movement and Settings save automatically. Keybindings and Pie Menus use Save changes." Style="{StaticResource Help}"/>
    <TextBlock Text="{Binding Warning}" Foreground="{DynamicResource Theme8A3C16}" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger><Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Button Content="Reset current profile" Click="Reset_Click" HorizontalAlignment="Left" Margin="0,14,0,6" BorderBrush="{DynamicResource Theme8A3C16}"/><TextBlock Text="Resets controller settings and pie menus for this profile. Other profiles, theme and Windows startup are kept." Style="{StaticResource Help}"/>
   </StackPanel></Border>
  </local:SettingsPanel>
 </Grid></Grid></Grid>
</TabItem>
    </TabControl>
    </Grid>

  </Grid>
</Window>
