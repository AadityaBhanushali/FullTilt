<Application x:Class="FullTilt.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FullTilt" ShutdownMode="OnExplicitShutdown">
  <Application.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ChromeStyles.xaml"/></ResourceDictionary.MergedDictionaries><local:ComboLabelConverter x:Key="ComboLabel" />
    <Style x:Key="PieListItem" TargetType="ListBoxItem"><Setter Property="local:UiMotion.Interactive" Value="True"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Margin" Value="0,3" /><Setter Property="Padding" Value="7,4" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="Item" Background="Transparent" CornerRadius="12" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="{DynamicResource ThemeE0E5DC}"><ContentPresenter /></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource ThemeECFBCD}" /><Setter TargetName="Item" Property="BorderBrush" Value="{DynamicResource ThemeECFBCD}" /></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Item" Property="BorderBrush" Value="{DynamicResource Theme84BC3B}" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PieCategory" TargetType="Expander"><Setter Property="local:UiMotion.Interactive" Value="True"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
        <StackPanel>
          <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Content="{TemplateBinding Header}" HorizontalContentAlignment="Stretch">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
              <Border x:Name="Category" Background="{DynamicResource ThemeFCFDFB}" BorderBrush="{DynamicResource ThemeE0E5DC}" BorderThickness="1" CornerRadius="10" Padding="10,10">
                <DockPanel><TextBlock x:Name="Chevron" DockPanel.Dock="Right" Text="⌄" Margin="8,0,0,0" /><ContentPresenter /></DockPanel>
              </Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Text" Value="⌃" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Category" Property="BorderBrush" Value="{DynamicResource Theme84BC3B}" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter x:Name="Body" ContentSource="Content" Visibility="Collapsed" Margin="4,4,0,0" />
        </StackPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible" /></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <SolidColorBrush x:Key="Theme192218" Color="#192218" />
<SolidColorBrush x:Key="Theme26361A" Color="#26361A" />
<SolidColorBrush x:Key="Theme427B0E" Color="#427B0E" />
<SolidColorBrush x:Key="Theme84BC3B" Color="#84BC3B" />
<SolidColorBrush x:Key="Theme8A3C16" Color="#8A3C16" />
<SolidColorBrush x:Key="ThemeA9D26E" Color="#A9D26E" />
<SolidColorBrush x:Key="ThemeBAEF6C" Color="#BAEF6C" />
<SolidColorBrush x:Key="ThemeD7F2AB" Color="#D7F2AB" />
<SolidColorBrush x:Key="ThemeDCE2D8" Color="#DCE2D8" />
<SolidColorBrush x:Key="ThemeDDE5D7" Color="#DDE5D7" />
<SolidColorBrush x:Key="ThemeE0E5DC" Color="#E0E5DC" />
<SolidColorBrush x:Key="ThemeE0E5DD" Color="#E0E5DD" />
<SolidColorBrush x:Key="ThemeE2E8E8" Color="#E2E8E8" />
<SolidColorBrush x:Key="ThemeE7EBE3" Color="#E7EBE3" />
<SolidColorBrush x:Key="ThemeEAF9CA" Color="#EAF9CA" />
<SolidColorBrush x:Key="ThemeECFBCB" Color="#ECFBCB" />
<SolidColorBrush x:Key="ThemeECFBCD" Color="#ECFBCD" />
<SolidColorBrush x:Key="ThemeEDF0E9" Color="#EDF0E9" />
<SolidColorBrush x:Key="ThemeF0F8E7" Color="#F0F8E7" />
<SolidColorBrush x:Key="ThemeFAFCF8" Color="#FAFCF8" />
<SolidColorBrush x:Key="ThemeFCFDFB" Color="#FCFDFB" />
<SolidColorBrush x:Key="ThemeFDFEFC" Color="#FDFEFC" />
<SolidColorBrush x:Key="ThemeFFFFFF" Color="#FFFFFF" />
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <SolidColorBrush x:Key="Ink" Color="#161B17" />
    <SolidColorBrush x:Key="Muted" Color="#767D77" />
    <SolidColorBrush x:Key="Accent" Color="#427B0E" />
    <Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI" /><Setter Property="FontSize" Value="13" /><Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter Property="Background" Value="{DynamicResource ThemeFAFCF8}" /></Style>
    <Style x:Key="FocusRing" TargetType="Control"><Setter Property="Template"><Setter.Value><ControlTemplate><Rectangle Margin="-3" Stroke="{DynamicResource Theme427B0E}" StrokeThickness="2" StrokeDashArray="2 1" RadiusX="4" RadiusY="4" /></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="Button"><Setter Property="local:UiMotion.Interactive" Value="True"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter Property="Background" Value="{DynamicResource ThemeFFFFFF}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeE0E5DD}" /><Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="16,9" /><Setter Property="MinHeight" Value="38" /><Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" /></Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.84" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.65" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.5" /></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox"><Setter Property="local:UiMotion.Interactive" Value="True"/><Setter Property="Background" Value="{DynamicResource ThemeFCFDFB}" /><Setter Property="BorderBrush" Value="{DynamicResource ThemeE0E5DC}" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{DynamicResource ThemeFCFDFB}" BorderBrush="{DynamicResource ThemeE0E5DC}" BorderThickness="1" CornerRadius="12" /></ControlTemplate></ToggleButton.Template></ToggleButton><TextBlock IsHitTestVisible="False" Margin="12,7,28,7" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"><TextBlock.Text><MultiBinding Converter="{StaticResource ComboLabel}"><Binding Path="SelectedItem" RelativeSource="{RelativeSource TemplatedParent}" /><Binding Path="DisplayMemberPath" RelativeSource="{RelativeSource TemplatedParent}" /><Binding Path="ItemStringFormat" RelativeSource="{RelativeSource TemplatedParent}" /></MultiBinding></TextBlock.Text></TextBlock><TextBlock Text="⌄" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False" /><Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="None"><Border Background="{DynamicResource ThemeFFFFFF}" CornerRadius="12" BorderBrush="{DynamicResource ThemeDDE5D7}" BorderThickness="1" Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" /></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter><Setter Property="MinHeight" Value="34" /><Setter Property="Padding" Value="8,5" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" /></Style>
    <Style TargetType="Slider"><Setter Property="Foreground" Value="{DynamicResource Accent}" /><Setter Property="Margin" Value="0,4,0,0" /><Setter Property="MinHeight" Value="20" /><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" /><Setter Property="IsMoveToPointEnabled" Value="True" /></Style>
    <Style TargetType="TextBox"><Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter Property="Background" Value="{DynamicResource ThemeFCFDFB}" /><Setter Property="BorderBrush" Value="{DynamicResource ThemeDCE2D8}" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost" /></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource Theme84BC3B}" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter><Setter Property="Padding" Value="6,4" /><Setter Property="MinHeight" Value="30" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" /><Style.Triggers><Trigger Property="Validation.HasError" Value="True"><Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}" /></Trigger></Style.Triggers></Style>
    <Style TargetType="TabItem"><Setter Property="local:UiMotion.Interactive" Value="True"/>
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Setter Property="Padding" Value="8,16" /><Setter Property="Margin" Value="6,6,6,6" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FontWeight" Value="SemiBold" /><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="TabFrame" CornerRadius="12" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
            <Grid>
              <Border x:Name="ActiveMark" Width="4" CornerRadius="2" Background="{DynamicResource ThemeBAEF6C}" HorizontalAlignment="Left" Margin="-5,-10,0,-10" Visibility="Collapsed" />
              <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" RecognizesAccessKey="True" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter TargetName="TabFrame" Property="Background" Value="{DynamicResource ThemeECFBCD}" /><Setter TargetName="ActiveMark" Property="Visibility" Value="Visible" /></Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Ink}" />
              <Setter TargetName="TabFrame" Property="Background" Value="{DynamicResource ThemeEAF9CA}" />
              <Setter TargetName="TabFrame" Property="BorderBrush" Value="{DynamicResource ThemeE7EBE3}" />
              <Setter TargetName="TabFrame" Property="CornerRadius" Value="12" />
              <Setter TargetName="ActiveMark" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style TargetType="ToggleButton"><Setter Property="local:UiMotion.Interactive" Value="True"/></Style>
    <Style TargetType="Expander"><Setter Property="local:UiMotion.Interactive" Value="True"/></Style>
    <Style TargetType="ListBoxItem"><Setter Property="local:UiMotion.Interactive" Value="True"/></Style>
    <Style TargetType="RadioButton"><Setter Property="local:UiMotion.Interactive" Value="True"/></Style>
    <Style TargetType="Label"><Setter Property="Foreground" Value="{DynamicResource Ink}" /></Style>
    <Style TargetType="TabControl"><Setter Property="Foreground" Value="{DynamicResource Ink}" /></Style>
    <Style TargetType="ListBox"><Setter Property="Background" Value="{DynamicResource ThemeFFFFFF}" /><Setter Property="Foreground" Value="{DynamicResource Ink}" /></Style>
    <Style TargetType="ContextMenu"><Setter Property="local:UiMotion.Interactive" Value="True"/><Setter Property="Background" Value="{DynamicResource ThemeFFFFFF}" /><Setter Property="Foreground" Value="{DynamicResource Ink}" /></Style>
    <Style TargetType="CheckBox"><Setter Property="local:UiMotion.Interactive" Value="True"/><Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource ThemeFFFFFF}" /><Setter Property="BorderBrush" Value="{DynamicResource ThemeE7EBE3}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="20" /></Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter Property="FontSize" Value="18" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,0,0,6" /></Style>
    <Style x:Key="Help" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="FontSize" Value="12" /><Setter Property="LineHeight" Value="18" /></Style>
  </ResourceDictionary></Application.Resources>
</Application>
